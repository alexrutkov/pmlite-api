<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="20240123_create_task_tags" author="alur">
        <createTable tableName="task_tags" >
            <column name="task_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="tag_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_tasks_task_tags"
                                 baseTableName="task_tags" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
        />
        <addForeignKeyConstraint constraintName="fk_tags_task_tags"
                                 baseTableName="task_tags" baseColumnNames="tag_id"
                                 referencedTableName="tags" referencedColumnNames="id"
        />
    </changeSet>
</databaseChangeLog>
